{
  "name": "huekit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write \"src/**/*.{js,vue,css}\" \"index.html\" \"vite.config.js\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,css}\" \"index.html\" \"vite.config.js\""
  },
  "dependencies": {
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "prettier": "^3.10.0",
    "stylelint": "^15.11.0",
    "stylelint-config-standard": "^34.0.0",
    "vite": "^7.0.6"
  }
}
